<script>
let token=localStorage.getItem('vector_token')||'';
let conversationId=localStorage.getItem('vector_conversation')||'';
let tts=false;
let recognition=null;

const $=id=>document.getElementById(id);

function openModal(id){
 $(id).classList.add('open');
}

function closeModal(id){
 $(id).classList.remove('open');
}

function toggleSidebar(){
 $('sidebar').classList.toggle('open');
}

function openLogin(){openModal('loginModal')}
function openImageModal(){openModal('imageModal')}
function openSearchModal(){openModal('searchModal')}
function openFilesModal(){openModal('filesModal')}
function openMemoryModal(){openModal('memoryModal');loadMemory()}
function openProjectsModal(){openModal('projectsModal');loadProjects()}
function openAgentModal(){openModal('agentModal')}
function openAssistantsModal(){openModal('assistantsModal');loadAssistants()}
function openSettingsModal(){openModal('settingsModal')}

async function api(url,options={}){
 options.headers=options.headers||{};

 if(token){
  options.headers.Authorization='Bearer '+token;
 }

 const r=await fetch(url,options);

 let data={};

 try{
  data=await r.json();
 }catch{}

 if(r.status===401){
  openLogin();
  throw new Error(data.error||'Authentication required');
 }

 if(!r.ok){
  throw new Error(data.error||'Request failed');
 }

 return data;
}

function addMessage(role,text){
 $('empty').classList.add('hidden');

 const row=document.createElement('div');
 row.className='message '+role;

 const bubble=document.createElement('div');
 bubble.className='bubble';
 bubble.textContent=text;

 row.appendChild(bubble);
 $('messages').appendChild(row);

 $('chat').scrollTop=$('chat').scrollHeight;

 return bubble;
}

async function sendMessage(){
 const input=$('prompt');
 const text=input.value.trim();

 if(!text)return;

 input.value='';
 input.style.height='auto';

 addMessage('user',text);

 const loading=addMessage('ai','VECTOR is thinking…');

 try{

  const data=await api('/api/chat',{
   method:'POST',
   headers:{'Content-Type':'application/json'},
   body:JSON.stringify({
    message:text,
    conversationId:conversationId||undefined,
    model:$('model').value||undefined
   })
  });

  conversationId=data.conversationId||conversationId;

  if(conversationId){
   localStorage.setItem('vector_conversation',conversationId);
  }

  loading.textContent=data.content||'VECTOR returned an empty response.';

  speak(data.content||'');

 }catch(e){

  loading.textContent=e.message;

  if(!token){
   openLogin();
  }
 }
}

function quick(text){
 $('prompt').value=text;
 sendMessage();
}

async function register(){

 const email=$('authEmail').value.trim();
 const password=$('authPassword').value;
 const displayName=$('authName').value.trim();

 if(!email||password.length<8){
  return showAuth('Enter a valid email and an 8+ character password.');
 }

 try{

  const data=await api('/api/auth/register',{
   method:'POST',
   headers:{'Content-Type':'application/json'},
   body:JSON.stringify({email,password,displayName})
  });

  token=data.token;
  localStorage.setItem('vector_token',token);

  closeModal('loginModal');
  showAuth('Account created.');

 }catch(e){
  showAuth(e.message);
 }
}

async function login(){

 const email=$('authEmail').value.trim();
 const password=$('authPassword').value;

 try{

  const data=await api('/api/auth/login',{
   method:'POST',
   headers:{'Content-Type':'application/json'},
   body:JSON.stringify({email,password})
  });

  token=data.token;

  localStorage.setItem('vector_token',token);

  closeModal('loginModal');

 }catch(e){
  showAuth(e.message);
 }
}

function showAuth(text){
 $('authMessage').textContent=text;
 $('authMessage').classList.remove('hidden');
}

function logout(){
 token='';
 conversationId='';
 localStorage.removeItem('vector_token');
 localStorage.removeItem('vector_conversation');
 closeModal('settingsModal');
 alert('Signed out.');
}

async function generateImage(){

 const prompt=$('imagePrompt').value.trim();

 if(!prompt)return;

 const result=$('imageResult');

 result.innerHTML='<div class="notice">Generating image…</div>';

 try{

  const data=await api('/api/images/generate',{
   method:'POST',
   headers:{'Content-Type':'application/json'},
   body:JSON.stringify({
    prompt,
    model:$('imageModel').value
   })
  });

  result.innerHTML=`
   <img class="generated-image" src="${escapeAttr(data.url)}" alt="Generated by VECTOR">
   <button class="secondary" onclick="window.open('${escapeAttr(data.url)}','_blank')">Open full image</button>
  `;

 }catch(e){

  result.innerHTML='<div class="notice">'+escapeHtml(e.message)+'</div>';
 }
}

async function searchWeb(){

 const q=$('searchInput').value.trim();

 if(!q)return;

 const box=$('searchResults');

 box.innerHTML='<div class="notice">Searching…</div>';

 try{

  const data=await api('/api/search?q='+encodeURIComponent(q));

  if(!data.results?.length){
   box.innerHTML='<div class="notice">No results found.</div>';
   return;
  }

  box.innerHTML=data.results.map(x=>`
   <div class="feature-card" style="margin-bottom:8px">
    <strong>${escapeHtml(x.title)}</strong>
    <span>${escapeHtml(x.snippet||'')}</span>
    <br>
    <a href="${escapeAttr(x.url)}" target="_blank" style="color:#36d9ff;font-size:10px">Open source ↗</a>
   </div>
  `).join('');

 }catch(e){

  box.innerHTML='<div class="notice">'+escapeHtml(e.message)+'</div>';
 }
}

async function analyzeFile(){

 const file=$('fileInput').files[0];

 if(!file)return;

 const form=new FormData();

 form.append('file',file);

 $('fileResult').innerHTML='<div class="notice">Analysing file…</div>';

 try{

  const data=await api('/api/files/analyze',{
   method:'POST',
   body:form
  });

  $('fileResult').innerHTML=`
   <div class="feature-card">
    <strong>${escapeHtml(data.filename)}</strong>
    <span>${escapeHtml(data.message||'Analysis complete.')}</span>
    ${data.text?`<pre style="white-space:pre-wrap;margin-top:10px;color:#9eacc1;font-size:10px;max-height:260px;overflow:auto">${escapeHtml(data.text)}</pre>`:''}
   </div>
  `;

 }catch(e){

  $('fileResult').innerHTML='<div class="notice">'+escapeHtml(e.message)+'</div>';
 }
}

async function saveMemory(){

 const content=$('memoryInput').value.trim();

 if(!content)return;

 try{

  await api('/api/memory',{
   method:'POST',
   headers:{'Content-Type':'application/json'},
   body:JSON.stringify({content,source:'user'})
  });

  $('memoryInput').value='';
  loadMemory();

 }catch(e){

  $('memoryList').innerHTML='<div class="notice">'+escapeHtml(e.message)+'</div>';
 }
}

async function loadMemory(){

 try{

  const data=await api('/api/memory');

  $('memoryList').innerHTML=data.length
   ?data.map(x=>`
    <div class="feature-card" style="margin-bottom:8px">
     <span>${escapeHtml(x.content)}</span>
    </div>
   `).join('')
   :'<div class="notice">No memories yet.</div>';

 }catch(e){

  $('memoryList').innerHTML='<div class="notice">'+escapeHtml(e.message)+'</div>';
 }
}

async function createProject(){

 const name=$('projectName').value.trim();

 if(!name)return;

 try{

  await api('/api/projects',{
   method:'POST',
   headers:{'Content-Type':'application/json'},
   body:JSON.stringify({
    name,
    description:$('projectDescription').value
   })
  });

  $('projectName').value='';
  $('projectDescription').value='';
  loadProjects();

 }catch(e){

  $('projectList').innerHTML='<div class="notice">'+escapeHtml(e.message)+'</div>';
 }
}

async function loadProjects(){

 try{

  const data=await api('/api/projects');

  $('projectList').innerHTML=data.length
   ?data.map(x=>`
    <div class="feature-card" style="margin-bottom:8px">
     <strong>${escapeHtml(x.name)}</strong>
     <span>${escapeHtml(x.description||'')}</span>
    </div>
   `).join('')
   :'<div class="notice">No projects yet.</div>';

 }catch(e){

  $('projectList').innerHTML='<div class="notice">'+escapeHtml(e.message)+'</div>';
 }
}

async function runAgent(){

 const goal=$('agentGoal').value.trim();

 if(!goal)return;

 $('agentResult').innerHTML='<div class="notice">VECTOR Agent is planning…</div>';

 try{

  const data=await api('/api/agents/run',{
   method:'POST',
   headers:{'Content-Type':'application/json'},
   body:JSON.stringify({goal})
  });

  $('agentResult').innerHTML=`
   <div class="feature-card">
    <strong>Agent plan</strong>
    <span style="white-space:pre-wrap">${escapeHtml(data.plan||'')}</span>
   </div>
  `;

 }catch(e){

  $('agentResult').innerHTML='<div class="notice">'+escapeHtml(e.message)+'</div>';
 }
}

async function createAssistant(){

 const name=$('assistantName').value.trim();

 if(!name)return;

 try{

  await api('/api/assistants',{
   method:'POST',
   headers:{'Content-Type':'application/json'},
   body:JSON.stringify({
    name,
    description:$('assistantDescription').value,
    instructions:$('assistantInstructions').value
   })
  });

  $('assistantName').value='';
  $('assistantDescription').value='';
  $('assistantInstructions').value='';

  loadAssistants();

 }catch(e){

  $('assistantList').innerHTML='<div class="notice">'+escapeHtml(e.message)+'</div>';
 }
}

async function loadAssistants(){

 try{

  const data=await api('/api/assistants');

  $('assistantList').innerHTML=data.length
   ?data.map(x=>`
    <div class="feature-card" style="margin-bottom:8px">
     <strong>${escapeHtml(x.name)}</strong>
     <span>${escapeHtml(x.description||'')}</span>
    </div>
   `).join('')
   :'<div class="notice">No custom assistants yet.</div>';

 }catch(e){

  $('assistantList').innerHTML='<div class="notice">'+escapeHtml(e.message)+'</div>';
 }
}

function toggleVoice(){

 if(!('SpeechRecognition' in window||'webkitSpeechRecognition' in window)){
  alert('Voice recognition is not supported in this browser.');
  return;
 }

 const SR=window.SpeechRecognition||window.webkitSpeechRecognition;

 if(recognition){
  recognition.stop();
  recognition=null;
  return;
 }

 recognition=new SR();

 recognition.lang='en-US';
 recognition.interimResults=false;

 recognition.onresult=e=>{
  $('prompt').value=e.results[0][0].transcript;
 };

 recognition.onend=()=>{
  recognition=null;
 };

 recognition.start();
}

function speak(text){

 if(!tts||!('speechSynthesis' in window))return;

 speechSynthesis.cancel();

 const u=new SpeechSynthesisUtterance(text);

 speechSynthesis.speak(u);
}

function showHome(button){

 document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));

 if(button)button.classList.add('active');

 $('sidebar').classList.remove('open');
}

function newChat(){

 conversationId='';
 localStorage.removeItem('vector_conversation');

 $('messages').innerHTML='';
 $('empty').classList.remove('hidden');
 $('sessionTitle').textContent='VECTOR';

 showHome();
}

function escapeHtml(value){

 return String(value??'')
  .replaceAll('&','&amp;')
  .replaceAll('<','&lt;')
  .replaceAll('>','&gt;')
  .replaceAll('"','&quot;')
  .replaceAll("'","&#039;");
}

function escapeAttr(value){

 return escapeHtml(value);
}

$('prompt').addEventListener('keydown',e=>{

 if(e.key==='Enter'&&!e.shiftKey){

  e.preventDefault();
  sendMessage();

 }
});

$('prompt').addEventListener('input',e=>{

 e.target.style.height='auto';
 e.target.style.height=Math.min(e.target.scrollHeight,140)+'px';

});

async function boot(){

 try{

  const h=await fetch('/api/health');

  if(h.ok){

   const data=await h.json();

   $('sessionTitle').textContent=data.name||'VECTOR';

  }

 }catch{}

 if(!token){

  // Do not force the login screen immediately.
  // User can explore the public interface first.
 }

}

boot();
</script>

